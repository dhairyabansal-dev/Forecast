# ---------- App ----------
APP_NAME=NetworkThreatForecast
APP_ENV=development
DEBUG=false
SECRET_KEY=generate-a-random-secret-at-least-32-characters

# ---------- API ----------
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:5173"]

# ---------- Authentication ----------
ACCESS_TOKEN_EXPIRE_MINUTES=720
AUTH_COOKIE_NAME=foreflow_session
AUTH_COOKIE_SECURE=false
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---------- Database ----------
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5432/DATABASE
POSTGRES_USER=change_me
POSTGRES_PASSWORD=change_me
POSTGRES_DB=ntf_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ---------- ML Engine ----------
ANOMALY_MODEL_PATH=ml_engine/saved_models/anomaly_model.pkl
TEMPORAL_MODEL_PATH=ml_engine/saved_models/temporal_model.pt
WORLD_MODEL_PATH=models/network_world_model.pth
FORECAST_HORIZON=24
SEQUENCE_LENGTH=48

# ---------- Blockchain ----------
BLOCKCHAIN_PROVIDER_URL=http://localhost:8545
BLOCKCHAIN_CHAIN_ID=1337
BLOCKCHAIN_PRIVATE_KEY=
THREAT_EVIDENCE_CONTRACT_ADDRESS=

# ---------- Logging ----------
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
