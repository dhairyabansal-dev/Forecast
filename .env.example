# ---------- App ----------
APP_NAME=NetworkThreatForecast
APP_ENV=development
DEBUG=false
SECRET_KEY=change_this_to_a_random_secret_key

# ---------- API ----------
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ---------- Database ----------
DATABASE_URL=postgresql+asyncpg://ntf_user:ntf_password@localhost:5432/ntf_db
POSTGRES_USER=ntf_user
POSTGRES_PASSWORD=ntf_password
POSTGRES_DB=ntf_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ---------- ML Engine ----------
ANOMALY_MODEL_PATH=ml_engine/saved_models/anomaly_model.pkl
TEMPORAL_MODEL_PATH=ml_engine/saved_models/temporal_model.pt
WORLD_MODEL_PATH=models/network_world_model.pth
FORECAST_HORIZON=24
SEQUENCE_LENGTH=48

# ---------- Blockchain ----------
BLOCKCHAIN_PROVIDER_URL=http://localhost:8545
BLOCKCHAIN_CHAIN_ID=1337
BLOCKCHAIN_PRIVATE_KEY=your_private_key_here
THREAT_EVIDENCE_CONTRACT_ADDRESS=

# ---------- Logging ----------
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
